# =============================================================================
# Tzara configuration.  Copy this file to `.env` and edit as needed:
#
#     cp .env.template .env        (macOS / Linux)
#     copy .env.template .env      (Windows cmd)
#
# The defaults below are chosen to "just work" on a fresh clone with Docker
# Desktop: no host paths to create, storage lives in Docker-managed named
# volumes, and the two default local models are pulled for you on first start.
# Everything under "ADVANCED" is optional.
# =============================================================================

# --- Which Docker Compose files to layer ------------------------------------
# Base file only = CPU-only Ollama (works everywhere, slow for large models).
# Add an overlay for GPU acceleration or to use an inference server you run yourself:
#   docker-compose.nvidia.yml             NVIDIA GPU passthrough
#   docker-compose.amd.yml                AMD ROCm GPU passthrough
#   docker-compose.external-inference.yml no local Ollama container; point at an
#                                         external server (Ollama/Lemonade/vLLM/...)
#                                         via LLM_URL + LLM_PROVIDER below
# COMPOSE_PATH_SEPARATOR is ';' on Windows/Docker Desktop, ':' on macOS/Linux.
COMPOSE_PATH_SEPARATOR=:
COMPOSE_FILE=docker-compose.yml

# --- Timezone ---------------------------------------------------------------
# One value, handed to every container. It decides three things:
#   - when wall-clock agent schedules fire ("daily @ 4:30 pm" means YOUR 4:30 pm)
#   - the zone every timestamp in the UI is displayed in
#   - what datetime.now() returns inside a jupyter code cell
# Leave it UTC and all three stay UTC, so a page saved at 8:30 pm shows up in
# your history as 1:30 the next morning. Use a tzdata name, not an offset -
# "America/Chicago" tracks daylight saving, "-0500" does not.
# TZ=America/Chicago
TZ=UTC

# --- Where your notes live --------------------------------------------------
# VAULTS_LOCATION is the PARENT directory; each immediate subdirectory is one
# isolated vault. Point this at your notes root (an Obsidian vault's parent
# works - those files are just markdown). The default keeps a starter vault
# inside the repo so a fresh clone has something to show.
VAULTS_LOCATION=./app/vaults
# Git history parent: one git-dir per vault (vault-history/{slug}). Keep this on
# a NON-synced location so git's temp-file churn never races Dropbox/OneDrive.
# For host-native git to also work, VAULTS_LOCATION and HISTORY_LOCATION must be
# same-named siblings (.../vaults and .../vault-history) under one parent.
HISTORY_LOCATION=./app/vault-history
# Which vault the landing page opens by default (a subdirectory of VAULTS_LOCATION).
DEFAULT_VAULT=main

# The app source is bind-mounted for live reload in development; leave as-is.
APP_LOCATION=./app

# --- Web server -------------------------------------------------------------
PORT=8000

# --- Theme ------------------------------------------------------------------
# Name of a folder under app/template/. "default" is the built-in theme.
# A theme only needs the files it overrides; everything else falls back to
# default, so a drift-free theme can be a single theme.css that recolors the
# whole wiki. See app/template/ocean/ (and its README.md) for a worked example.
#
# This is the SITE-WIDE fallback. An individual vault can override it with a
# "template" key in its .tzara/config.json, so each vault reads as its own place
# at a glance; pages belonging to no vault (/vaults, /manage/*) always use this.
#   TZARA_TEMPLATE=ocean
TZARA_TEMPLATE=default

# --- Storage (Docker named volumes by default; no host paths to create) -----
# These are named volumes managed by Docker - cross-platform and zero-setup.
# To store data at a specific host path instead, set an absolute path here
# (e.g. POSTGRES_DATA_LOCATION=D:/DATA/postgres or /srv/tzara/pg). 
# These allow you to stor database data file and ollama model files outside
# of the container or docker volume, which is preferable.
POSTGRES_DATA_LOCATION=pg_data
OLLAMA_MODELS=ollama_models

# --- Postgres (pgvector) ----------------------------------------------------
# Local-only DB, reachable ONLY on the internal tzara-net bridge: its container
# port is NOT published to the host (the `ports:` mapping in docker-compose.yml
# is commented out - uncomment it if you want to poke the DB directly during dev).
# The password is not a host-exposure knob, but it IS the boundary between the
# page-execution Jupyter kernel (also on tzara-net, runs LLM/user code) and this
# DB, so set it deliberately rather than leaving the placeholder.
#
# These credentials are what the Postgres container INITIALIZES with on first
# start, and the app reads the SAME values from this file to connect - so both
# sides stay in sync as long as you set them here. IMPORTANT: Postgres bakes the
# password into its data volume during that first init and never re-reads it;
# editing POSTGRES_PASSWORD afterward will break auth (the app sends the new
# value, the DB still has the old one) until you recreate the volume.
#
# setup.sh / setup.ps1 replace the placeholder below with a strong random
# password on first run, so you normally never touch it. If you copy this
# template by hand instead, change the placeholder before your first `up`.
# The fallbacks in config.py and docker-compose.yml are tzara / tzara /
# change_this_password (DB / user / password), used only for a bare `up` with
# no .env at all.
POSTGRES_DB=tzara
POSTGRES_USER=tzara
POSTGRES_PASSWORD=change_this_password
# ADVANCED: the app always reaches Postgres at the compose service name `postgres`
# on port 5432 over tzara-net, so these only matter if you ALSO uncomment the host
# port mapping in docker-compose.yml. Left commented so config.py is the single
# source of truth for them (the same one-source pattern Redis already uses).
#POSTGRES_HOST=postgres
#POSTGRES_PORT=5432

# --- LLM server -------------------------------------------------------------
# Out of the box Tzara runs a local Ollama container and pulls these two models
# on first start (see the ollama-init service). The chat model is small so it
# fits modest hardware; swap in a larger model once you confirm things work.
# Point LLM_URL anywhere that speaks OpenAI /v1 (Ollama, Lemonade, vLLM, ...) to
# use an existing server instead; see LLM_PROVIDER below.
#
# These were named OLLAMA_* before Tzara spoke to anything but Ollama. The old
# names still work, so an .env from an earlier release needs no edit.
LLM_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
LLM_EMBED_MODEL=embeddinggemma:300m
LLM_KEEP_ALIVE=30m

# Folders never indexed / never treated as vault content.
EXCLUDED_FOLDERS=.obsidian,.git,.trash,__pycache__


# =============================================================================
# ADVANCED - everything below is optional; sensible defaults live in config.py.
# =============================================================================

# --- LLM backend provider (see app/config.py + app/src/llm_backend.py) -------
# How Tzara talks to its local LLM. Inference (chat/tools/stream) always uses the
# universal OpenAI /v1 surface; model management + embeddings use the Ollama-native
# /api/* surface when the server offers it. Default `ollama` is the out-of-box path.
#   ollama        - stock Ollama server (chat via /v1, embed+mgmt native)
#   lemonade      - Lemonade (chat via /api/v1; its Ollama chat mount can't stream
#                   with tools). Set this if LLM_URL points at a Lemonade server.
#   openai        - any pure OpenAI-compatible server (vLLM/LocalAI/etc); mgmt degrades
#   ollama-native - pre-seam native Ollama chat path (kill-switch)
#LLM_PROVIDER=ollama
# OpenAI /v1 base URL override; auto-derives from LLM_URL by provider convention
# (Ollama -> {url}/v1, Lemonade -> {url}/api/v1) when unset.
#LLM_BASE_URL=
# Max concurrent background LLM/embed requests (frontmatter generation, embedding,
# model warming - all run in the taskiq worker). Caps how hard a bulk reindex
# hammers a shared LLM server. 1 = fully serialized. Interactive chat is ungated.
#LLM_MAX_CONCURRENCY=1
# Let the agentic tool-calling loop "think" (reasoning channel) on tool-deciding
# turns. gpt-oss interleaves reasoning with tool calls, which Ollama's harmony
# parser can fail to parse; set false for fewer malformed calls at some tool-quality
# cost. Other LLM calls (memory/summary/edit) are unaffected.
#AGENT_TOOL_THINK=true
# /edit/ writing-assist runs on the chat model (LLM_MODEL). A dedicated edit-model
# knob was removed - it wasn't warmed/measured/clamped like the chat model, so it only
# looked like a separately-managed model. Per-command model pinning still exists in code.
# Optional edit-specific history budget (tokens) for /edit/ cursor-mode doc-context
# sizing. 0 (default) = inherit the chat model's resolved window (ask/measured/clamped).
# Set >0 only to cap edit context SMALLER for latency; clamped to the real window.
#LLM_EDIT_CONTEXT_BUDGET=0
# LLM_NUM_CTX = the context window to ASK the backend to load the chat/agent model
# with (tokens). 0 = don't request a size (backend auto-detects / uses its default).
# It's an ASK, not a guarantee - the backend may load smaller under memory pressure.
#   Ollama:   sent as num_ctx when warming (Ollama (re)loads at this window).
#   Lemonade: sent as ctx_size to POST /v1/load (its per-model llama-server honors it).
#LLM_NUM_CTX=0
# LLM_CONTEXT_BUDGET = the token window Tzara budgets chat/agent HISTORY against
# (how much conversation it packs before compaction trims). Separate from the ASK above
# because what you asked to load and what actually loaded can differ. 0 = auto: use the
# backend-MEASURED loaded window (e.g. Lemonade /v1/health ctx_size), else the ask, else
# the model ceiling, else 4096. Set >0 only to force a SMALLER budget (a latency/cost
# cap) - it is HARD-CLAMPED to the model's actual loaded window, so it can never exceed
# real capacity and make history silently drop.
#LLM_CONTEXT_BUDGET=0
# Hard ceiling on a single embedding input's token length (clip before send).
# Set to your embed model's context / the server's ubatch. 2048 = embeddinggemma.
#LLM_EMBED_MAX_TOKENS=2048
# Log running chat-history size on every add/checkpoint/trim (context-growth debug).
#CHAT_DEBUG_STATS=true
# Fence languages that become executable Jupyter cells (comma-separated).
# Default "jupyter" keeps ```python read-only. Use "python" for jupytext-style
# docs, or "jupyter,python" to make both runnable.
#EXECUTABLE_CODE_LANGUAGES=jupyter

# --- Agent subsystem (OFF by default - opt in once you understand it) --------
# Tzara can run background agents defined as markdown files in the system vault.
# They are powerful (scheduled/event-triggered runs, staged writes, sandboxed
# custom Python tools). Leave these disabled until you've read the authoring
# guide; flip to true to enable. See app/config.py for the full semantics.
#AGENT_SCHEDULER_ENABLED=false
#EVENT_TRIGGERS_ENABLED=false
# `run_python` lets the CHAT agent execute LLM-authored code in the page kernel
# (approval-gated per block). Off by default because note text read via search
# could carry prompt-injection that steers that code. Enable only if you trust
# your vaults' content.
#CHAT_ENABLE_RUN_PYTHON=false
#
# System vault slug (wiki-owned: agent definitions, help docs). Hidden from the
# vault switcher and never RAG-indexed, but browsable/editable at /wiki/{slug}/...
#SYSTEM_VAULT=dada
# Agent-owned output folder inside each content vault (digests, run logs).
#AGENT_OUTPUT_DIR=_dada
# Agent kernel / agent-API : custom-tool timeouts and the token secret.
# Secrets for custom tools go in this file and are passed to the
# jupyterserver-agent service via explicit "VAR=${VAR}" entries in
# docker-compose.yml; tool code reads os.environ["VAR"].
#AGENT_TOOL_TIMEOUT_S=60
#AGENT_RUN_TIMEOUT_S=3600
#AGENT_API_SECRET=
# Agent scheduler tuning (only relevant when AGENT_SCHEDULER_ENABLED=true).
#AGENT_SCHEDULER_TICK_S=60
#AGENT_DEFAULT_RUN_HOUR=4
#AGENT_STAGING_TTL_DAYS=14
# Cross-run agent memory + ledgers. Storage caps are STATIC and human-facing
# (how big before you should prune); how much gets INJECTED into the prompt is
# dynamic and scales with the model's context window. Do not tie the two
# together - scaling the storage caps down on a small model would start refusing
# writes, which loses data instead of merely showing less of it.
#AGENT_LEDGER_MAX_ITEMS=500
#AGENT_LEDGER_MAX_COUNT=10
# Share of the context window the ledgers page may occupy when injected, and the
# hard ceiling on it. Over budget, ledgers degrade gracefully: every ledger keeps
# its heading and true row count, newest-touched ledgers keep the most rows, and
# the agent can fetch what was elided with the `recall` tool.
#AGENT_LEDGER_CONTEXT_FRACTION=0.03
#AGENT_LEDGER_MAX_CHARS=16000
# Default number of rows `recall` returns. Static on purpose: the system prompt
# rides every turn and so must scale, but a tool result is one-shot.
#AGENT_LEDGER_RECALL_ROWS=200
# Event-trigger guards (only relevant when EVENT_TRIGGERS_ENABLED=true).
#EVENT_MAX_DEPTH=3
#EVENT_COOLDOWN_S=600
#EVENT_BUDGET_PER_HOUR=6
#EVENT_MAX_AGE_S=86400
#EVENT_STREAM_MAXLEN=10000
